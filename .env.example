PB_ENVIRONMENT=local
PB_LOG_JSON=false
# SQLite by default. Postgres: postgresql+asyncpg://user:pass@localhost:5432/pulseboard
PB_DATABASE_URL=sqlite+aiosqlite:///./pulseboard.db
PB_DB_AUTO_CREATE=true
PB_JWT_SECRET=local-dev-secret-change-me-32-bytes!!
PB_SERVICE_KEY=local-internal-service-key
PB_ENABLE_DEV_TOKEN=true
# Review queue: "sqs" (local moto server, mock AWS) or "azure" (Storage Queue)
PB_QUEUE_BACKEND=sqs
PB_AWS_ENDPOINT_URL=http://localhost:5000
PB_REVIEW_INTERVAL_MINUTES=60
PB_SETUP_BUILD_DELAY_SECONDS=2
